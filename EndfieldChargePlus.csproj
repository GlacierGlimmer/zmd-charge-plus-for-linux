<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-x86;linux-x64</RuntimeIdentifiers>
    <RootNamespace>EndfieldChargePlus</RootNamespace>
    <AssemblyName>EndfieldChargePlus</AssemblyName>
    <Product>Endfield Charge Plus</Product>
    <Title>Endfield Charge Plus</Title>
    <Company>GlacierGlimmer冰川雪貓</Company>
    <Authors>GlacierGlimmer冰川雪貓</Authors>
    <Copyright>© 2026 GlacierGlimmer冰川雪貓</Copyright>
    <Description>Configurable Endfield-style HUD for Windows and Linux</Description>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tray_bolt.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or $([MSBuild]::IsOSPlatform('Linux'))">
    <Product>Endfield Charge Plus For Linux</Product>
    <Title>Endfield Charge Plus For Linux</Title>
    <Description>Configurable Endfield-style HUD for Linux</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.2.0" />
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\tray_bolt.png" />
    <AvaloniaResource Include="Assets/Platforms/*.svg" />
    <AvaloniaResource Include="Assets/About/*.svg" />
    <Compile Remove="Tests\**\*.cs;scripts\localization\catalog\**" />
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/china-holidays.json" LogicalName="EndfieldChargePlus.china-holidays.json" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <EmbeddedResource Include="Localization/reviewed-language-catalog.json" WithCulture="false" LogicalName="EndfieldChargePlus.LanguageCatalog" />
    <EmbeddedResource Include="Localization/platform-fields.json" WithCulture="false" LogicalName="EndfieldChargePlus.PlatformFields" />
    <EmbeddedResource Include="Localization/reviewed-release-requirements.json" WithCulture="false" LogicalName="EndfieldChargePlus.LocaleReleaseRequirements" />
    <EmbeddedResource Include="Localization/reviewed-shared-words.json" Condition="Exists('Localization/reviewed-shared-words.json')" WithCulture="false" LogicalName="EndfieldChargePlus.LocaleSharedWords" />
    <EmbeddedResource Include="Localization/*.lang" WithCulture="false" LogicalName="EndfieldChargePlus.lang.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization/*.lang.sha256" WithCulture="false" LogicalName="EndfieldChargePlus.lang.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization/manual.*.json" WithCulture="false" LogicalName="EndfieldChargePlus.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Licenses/*-LICENSE.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Licenses/Filee-MIT.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Fonts/OFL-NotoSerifTibetan.txt" Link="licenses/NotoSerifTibetan-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Fonts/OFL-NotoSansGothic.txt" Link="licenses/NotoSansGothic-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Fonts/OFL-NotoSansDeseret.txt" Link="licenses/NotoSansDeseret-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
